# Copy to .env and adjust. Never commit .env.

# First admin account (created on first start only). If ADMIN_PASSWORD is blank,
# a temporary password is printed to the container log and must be changed at sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Public URL of the app (used in email links). Set COOKIE_SECURE=true when served over HTTPS.
BASE_URL=http://localhost:8080
COOKIE_SECURE=false

# Encrypts stored Southwest sessions. Leave blank to auto-generate /data/secret.key.
# If you set it, keep it stable: changing it makes stored sessions unreadable.
SECRET_KEY=

# Only for `python -m app login-test` on your own machine (tests automated Southwest sign-in).
# The server doesn't use these.
SWA_USERNAME=
SWA_PASSWORD=

# Gmail sender for alerts: app password from myaccount.google.com/apppasswords (requires 2FA)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Daily run time in TZ. Each day starts at a random time within ±SWA_DAILY_JITTER_MINUTES
# of SWA_DAILY_AT (a fixed time every day is a bot pattern). 0 = exact time.
SWA_DAILY_AT=07:20
SWA_DAILY_JITTER_MINUTES=45

# TZ must match where this server's internet connection is: sites compare the browser's time
# zone with the IP's location. Checked at start; the app won't start on a mismatch.
# Run `python -m app check-tz` to see what it finds. Skip only if you know better (e.g. a VPN).
SWA_SKIP_TZ_CHECK=false
TZ=America/Chicago

# Automatic Southwest sign-in (users opt in under Settings)
SWA_AUTO_LOGIN=true
SWA_CODE_WAIT_SECONDS=600

# Defaults for new users (admin can change per user)
DEFAULT_MAX_WATCHES=5
DEFAULT_MAX_SEARCHES_PER_DAY=40
MAX_DATES_PER_WATCH=31

# Docker
IMAGE=ghcr.io/dwightmulcahy/swa-fare-watcher:latest
HOST_PORT=8080
DATA_DIR=./data
QNAP_DATA_DIR=/share/Container/swa-fare-watcher/data
