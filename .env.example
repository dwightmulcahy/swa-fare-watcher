# Copy to .env and adjust (never commit .env).
# SWA Fare Watcher settings. Edited by the admin Settings page or by hand; the app reads
# them when it starts (docker compose env_file), so restart it after changing them.

# ---------- App ----------
# Public URL of the app, used in email links (default: http://localhost:8080)
BASE_URL=http://localhost:8080
# Set true when the app is served over HTTPS (default: false)
COOKIE_SECURE=false
# How long a web sign-in lasts (days) (default: 14)
# SESSION_DAYS=14
# Encrypts stored Southwest sessions. Blank = auto-generated /data/secret.key. Never change it
# once set: stored sessions become unreadable (default: blank)
SECRET_KEY=
# Skip the start-up time zone check (e.g. behind a VPN you trust) (default: false)
SWA_SKIP_TZ_CHECK=false

# ---------- First admin account (created on first start only) ----------
# Username of the first admin account (default: admin)
ADMIN_USERNAME=admin
# Its password. Blank = a temporary one is printed to the container log and must be changed at
# sign-in (default: blank)
ADMIN_PASSWORD=

# ---------- Email (Gmail app password: myaccount.google.com/apppasswords, needs 2-step verification) ----------
# Gmail address alerts are sent from (default: blank)
GMAIL_USER=you@gmail.com
# Its 16-character app password (default: blank)
GMAIL_APP_PASSWORD='xxxx xxxx xxxx xxxx'
# SMTP server (default: smtp.gmail.com)
# GMAIL_SMTP_HOST=smtp.gmail.com
# SMTP port (SSL) (default: 465)
GMAIL_SMTP_PORT=465

# ---------- Schedule ----------
# false turns off scheduled runs (Search now still works) (default: true)
# SWA_SCHEDULER=true
# Each user checks at 2-3 habitual times of day (morning, lunch, evening; later on weekends),
# one visit each; the rest continues at the next (default: true)
# SWA_HABIT_SLOTS=true
# Daily run time, when habitual times are off (default: 07:20)
SWA_DAILY_AT=07:20
# Each day starts within ± this many minutes of SWA_DAILY_AT (habitual times off) (default: 45)
SWA_DAILY_JITTER_MINUTES=45
# Each user's own usual time within ± this of SWA_DAILY_AT (habitual times off) (default: 120)
# SWA_USER_SPREAD_MINUTES=120
# Chance a user takes a day off (never two in a row, never with a booked flight to watch); 0 =
# every day (default: 0.12)
# SWA_SKIP_DAY_CHANCE=0.12

# ---------- Searching ----------
# Read the low-fare calendar first and fully search only the cheapest days (default: true)
SWA_CALENDAR=true
# Most days (round trip: date pairs) fully searched after the calendar, per direction (default:
# 6)
SWA_CALENDAR_DETAIL_DATES=6
# Scheduled runs search far-off dates less often and skip dates whose calendar price hasn't
# changed (default: true)
# SWA_ROTATE_DATES=true
# Page loads per account per day, a random number in this range (0,0 = no budget) (default:
# 20,35)
# SWA_DAILY_PAGE_BUDGET=20,35
# Seconds between searches: log-normal around the middle, with an occasional 45-180 s break
# (default: 8,20)
SWA_SEARCH_DELAY=8,20
# Page loads per visit; the browser closes between visits (0,0 = one visit per run) (default:
# 6,14)
# SWA_VISIT_SEARCHES=6,14
# Minutes between visits when a run has several (habitual times off) (default: 20,90)
# SWA_VISIT_BREAK=20,90
# Share of searches started from the Book a Flight form instead of a bookmarked address
# (default: 0.5)
SWA_FORM_SHARE=0.5
# After a block or challenge page, pause that user's scheduled runs this long (default: 36)
SWA_BLOCK_PAUSE_HOURS=36
# Hard cap on dates per watch (default: 31)
MAX_DATES_PER_WATCH=31
# Southwest home page (default: https://www.southwest.com/)
# SWA_HOME_URL=https://www.southwest.com/
# Book a Flight page (default: https://www.southwest.com/air/booking/)
# SWA_BOOK_URL=https://www.southwest.com/air/booking/
# Low-fare calendar page (default: https://www.southwest.com/air/low-fare-calendar/select-dates)
# SWA_CALENDAR_URL=https://www.southwest.com/air/low-fare-calendar/select-dates

# ---------- Browser ----------
# Draw with the NAS's Intel/AMD GPU instead of Chrome's software renderer (needs devices:
# /dev/dri and chmod 666 on the render node) (default: false)
# SWA_GPU=false
# GPU render node used with SWA_GPU (default: /dev/dri/renderD128)
# SWA_GPU_DEVICE=/dev/dri/renderD128
# Human-like mouse, keyboard, scrolling and reading around searches (default: true)
# SWA_HUMANIZE=true
# Browser time zone (blank = the container's TZ); match where the IP is (default: blank)
# SWA_TIMEZONE=
# true runs Chrome headless (no virtual screen; more likely blocked) (default: false)
# SWA_HEADLESS=false
# auto = Google Chrome if installed, else Chromium (default: auto)
# SWA_BROWSER_CHANNEL=auto

# ---------- Southwest sign-in ----------
# Let users turn on automatic sign-in (default: true)
SWA_AUTO_LOGIN=true
# How long a sign-in waits for a verification code (default: 600)
SWA_CODE_WAIT_SECONDS=600
# How often it checks for the code (default: 3)
# SWA_CODE_POLL_SECONDS=3

# ---------- Defaults for new users (an admin can change them per user) ----------
# Active watches per user (default: 5)
DEFAULT_MAX_WATCHES=5
# Searches per user per day (default: 40)
DEFAULT_MAX_SEARCHES_PER_DAY=40

# ---------- Alerts and upkeep ----------
# When daily and weekly digest emails go out (default: 18:00)
# SWA_DIGEST_AT=18:00
# Email the admins when no run has finished for this long; 0 = off (default: 26)
# SWA_STALE_HOURS=26
# Daily database backups kept in data/backups; 0 = off (default: 7)
# SWA_BACKUP_KEEP=7
# Where the database, browser profiles and logs live (default: /data)
# SWA_DATA_DIR=/data

# ---------- Docker (read by docker compose; apply with docker compose up -d) ----------
# Time zone of the container (e.g. America/Costa_Rica) (default: UTC)
TZ=America/Chicago
# Image to run (default: ghcr.io/dwightmulcahy/swa-fare-watcher:latest)
IMAGE=ghcr.io/dwightmulcahy/swa-fare-watcher:latest
# Port on the NAS the app is reachable on (default: 8080)
HOST_PORT=8080
# Data folder on the NAS (compose.qnap.yaml) (default: /share/Container/swa-fare-watcher/data)
QNAP_DATA_DIR=/share/Container/swa-fare-watcher/data
# Data folder (compose.yaml) (default: ./data)
DATA_DIR=./data
# This file, as seen by docker compose; mounted into the container so the admin Settings page
# can edit it (default: ./.env)
# ENV_FILE=./.env

# ---------- Only for python -m app login-test on your own computer (the server ignores these) ----------
# Southwest username for the sign-in test (default: blank)
SWA_USERNAME=
# Its password (default: blank)
SWA_PASSWORD=
