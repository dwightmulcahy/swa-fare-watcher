# Copy to .env and adjust. Never commit .env.

# Gmail sender: app password from myaccount.google.com/apppasswords (requires 2FA)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Daily run time (container) in TZ
SWA_DAILY_AT=07:20
TZ=America/Chicago

# Docker: image used by compose files (ghcr.io/<owner>/<repo> by default)
IMAGE=ghcr.io/dwightmulcahy/swa-fare-watcher:latest
# Host directory mounted at /data (compose.yaml)
DATA_DIR=./data
# QNAP (compose.qnap.yaml)
QNAP_DATA_DIR=/share/Container/swa-fare-watcher/data
